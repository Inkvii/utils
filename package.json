{
	"name": "@1nkvi/utils",
	"version": "0.2.0",
	"description": "Helper functions",
	"scripts": {
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"lint": "eslint --max-warnings=0 --cache",
		"lint:fix": "eslint --max-warnings=0 --cache --fix",
		"format": "prettier --check --cache ./src",
		"format:fix": "prettier --check --cache --write .",
		"test": "vitest run",
		"deploy": "pnpm publish --access public"
	},
	"keywords": [
		"merge"
	],
	"author": "1nkvi",
	"license": "ISC",
	"packageManager": "pnpm@11.9.0",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "24.10.8",
		"eslint": "10.5.0",
		"eslint-config-prettier": "10.1.8",
		"prettier": "3.8.2",
		"tsc-alias": "1.8.17",
		"typescript": "6.0.3",
		"typescript-eslint": "8.60.1",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=24"
	},
	"main": "build/artifacts/src/index.js",
	"types": "build/artifacts/src/index.d.ts",
	"exports": {
		".": {
			"import": "./build/artifacts/src/index.js",
			"types": "./build/artifacts/src/index.d.ts"
		}
	},
	"files": [
		"build/artifacts"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/Inkvii/utils.git"
	}
}
