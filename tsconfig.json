{
	"include": ["**/*"],
	"exclude": ["node_modules", ".pnpm-store", "build"],
	"compilerOptions": {
		"lib": ["ES2024", "DOM"],
		"types": ["node"],
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"incremental": true,
		"declaration": true,
		"outDir": "build/artifacts",
		"rootDir": ".",
		"paths": {
			"@/*": ["./*"],
			"~/*": ["./src/*"]
		},
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true
	}
}
